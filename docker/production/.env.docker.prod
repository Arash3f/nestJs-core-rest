NODE_ENV = "production"

# ! Server Config
serverAddress = "http://localhost"
serverPort = 3000
lokiServerAddress = "http://loki:3100"

# ! Swagger Doc url pattern
swaggerDocsPath = "api-docs"
swaggerPath = "api"

# ! JWT config section
jwtSecret = "asdasddasda"
jwtExpire = 10000

# ! Database config section
DATABASE_CONNECTION_URL = "postgres://admin:admin@postgres:5432/nestJsCoreRest"
databaseName = "nestJsCoreRest"
databaseUsername = "admin"
databasePassword = "admin"
databasePort = "5432"
databaseHost = "postgres"

# ! Super user default data (Auto generate in setup) !#
SUPER_USER_NAME = "admin"
SUPER_USER_USERNAME = "admin"
SUPER_USER_PASSWORD = "admin"