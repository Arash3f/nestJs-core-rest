{
  "name": "nest-js-core-rest",
  "version": "0.0.1",
  "description": "NestJs Core Rest",
  "author": "Arash Alfooneh",
  "private": true,
  "license": "MIT",
  "scripts": {
    "api": "npm run script scripts/generate-api.ts",
    "doc": "npx compodoc -p tsconfig.doc.json -n 'NestJs Core Rest'",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prepare": "husky",
    "build": "swc --delete-dir-on-start --out-dir dist/ src/",
    "start:prod": "node dist/src/main.js",
    "start:dev": "nest build --webpack --webpackPath webpack-hmr.config.js --watch"
  },
  "dependencies": {
    "@fastify/static": "^7.0.2",
    "@nanogiants/nestjs-swagger-api-exception-decorator": "^1.6.11",
    "@nestjs/common": "^10.3.7",
    "@nestjs/config": "^3.2.1",
    "@nestjs/core": "^10.3.7",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "10.3.7",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.3.1",
    "@prisma/client": "^5.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "0.14.1",
    "clean-deep": "^3.4.0",
    "cron": "^3.1.6",
    "hasha": "^5.2.2",
    "luxon": "^3.4.4",
    "husky": "^9.0.11",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^1.1.23",
    "@fastify/multipart": "^8.2.0",
    "@nestjs/cli": "^10.0.0",
    "@stylistic/eslint-plugin-js": "^1.7.0",
    "@swc/cli": "^0.3.12",
    "@swc/core": "^1.4.11",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.2",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "chokidar": "^3.5.3",
    "commitizen": "^4.3.0",
    "commitlint-config-gitmoji": "^2.3.1",
    "cz-customizable": "^7.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "fastify": "^4.26.2",
    "fastify-file-interceptor": "^1.0.9",
    "fastify-multer": "^2.0.3",
    "husky": "^9.0.11",
    "jest": "^29.5.0",
    "lint-staged": "^15.2.2",
    "multer": "1.4.5-lts.1",
    "prettier": "3.2.5",
    "prisma": "5.11.0",
    "reflect-metadata": "^0.2.2",
    "run-script-webpack-plugin": "^0.2.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.1",
    "tslib": "^2.6.2",
    "typescript": "^5.1.3",
    "webpack": "^5.91.0",
    "webpack-node-externals": "^3.0.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "config/path/to/my/config.js"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
